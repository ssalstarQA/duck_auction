<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
    <!-- 사진 크롭(uCrop) 화면 전용 테마. 상태바를 불투명(어두운 색)으로 그려서
         상단 툴바(✓/X)가 상태바(시간·와이파이)와 겹치지 않고 그 아래에 놓이게 해요. -->
    <style name="UCropTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">#FF1F2A44</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- 하단 네비게이션 바도 불투명(어두운 색)으로 그려서, 하단 컨트롤
             (비율·회전 등)이 시스템 네비바 밑에 깔리지 않고 그 위에 놓이게 해요. -->
        <item name="android:navigationBarColor">#FF1F2A44</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <!-- 콘텐츠가 상태바·네비바 인셋만큼 안쪽으로 배치되게 해서, 상단 툴바
             (✓/X)와 하단 컨트롤이 시스템 바에 가리지 않게 해요. -->
        <item name="android:fitsSystemWindows">true</item>
        <!-- Android 15(타깃 SDK 35+)의 edge-to-edge 강제를 이 화면에서만 꺼요.
             안 그러면 크롭 화면이 상태바 아래까지 그려져서 상단 툴바(✓/X)가
             상태바(시간·와이파이)와 겹치고, 크롭 영역 좌표도 어긋나요.
             (API 35 미만에서는 이 속성이 무시돼 안전해요.) -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
