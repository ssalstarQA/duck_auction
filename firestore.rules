rules_version = '2';

// ============================================================================
//  덕옥션 Firestore 보안 규칙
// ----------------------------------------------------------------------------
//  ⚠️ 배포 전 반드시 에뮬레이터/테스트 프로젝트에서 검증하세요.
//     이 규칙은 앱의 '실제 쓰기 경로'를 코드에서 전수조사해 맞춘 것이지만,
//     빠진 경로가 있으면 정상 기능이 막힐 수 있어요. 폐쇄테스트 중이라면
//     운영에 바로 배포하지 말고 먼저 `firebase emulators:start` 로 로그인/등록/
//     입찰/채팅/배송/구매확정/팔로우/리뷰 흐름을 한 번씩 돌려보세요.
//
//  마스터 관리자 판정: 앱과 동일하게 이메일로 판별해요. 토큰에 email이 있어야
//  동작하므로, 장기적으로는 커스텀 클레임(request.auth.token.admin == true)으로
//  옮기는 걸 권장해요(이메일은 변경/스푸핑 여지가 상대적으로 큼).
//
//  개인정보 주의: users 문서 안에 배송지(address)가 들어있어요. 규칙은 '문서 단위'
//  라서 특정 필드만 숨길 수 없어, 프로필/검색을 위해 users 읽기를 허용하면 주소도
//  같이 읽혀요. 근본 해결은 주소를 users/{uid}/private 서브컬렉션으로 분리하는 것.
//  (아래 users 규칙 하단 주석 참고 — 지금은 로그인 사용자 읽기 허용.)
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- 공통 헬퍼 ----
    function isSignedIn() {
      return request.auth != null;
    }
    function isMaster() {
      return isSignedIn() && request.auth.token.email == 'master@duckauction.com';
    }
    // create/update 모두에서 "이번 쓰기가 건드린 키"가 허용목록 안에 있는지 검사.
    // create면 resource가 없으므로 새 문서의 키 집합을, update면 변경분(diff)을 봄.
    function touchesOnly(keys) {
      return resource == null
        ? request.resource.data.keys().hasOnly(keys)
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ========================================================================
    //  products — 공개 마켓(누구나 읽기). 쓰기는 소유자/입찰/좋아요/신고로 제한.
    // ========================================================================
    match /products/{productId} {
      allow read: if true;

      // 등록: 로그인 사용자가 자기 소유(sellerId==uid)로만 생성.
      allow create: if isSignedIn()
                    && request.resource.data.sellerId == request.auth.uid;

      // 삭제: 소유자 또는 마스터(테스트 데이터 정리).
      allow delete: if isSignedIn()
                    && (resource.data.sellerId == request.auth.uid || isMaster());

      // 수정:
      //  (1) 소유자 — 상품 수정/재경매 연장/운송장 등록/숨김 등 자기 상품 전반.
      //  (2) 마스터 — 관리/테스트.
      //  (3) 비소유자 — 입찰·자동입찰·좋아요·신고로 인한 필드만 허용.
      //      (currentPrice/bidCount/lastBid*/bidderIds = 입찰,
      //       likeCount = 찜, reportCount/lastReportedAt = 신고)
      //      status·winnerId·feeExempt 등 '민감 필드'는 비소유자가 못 바꿔요.
      allow update: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid
        || isMaster()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'currentPrice', 'bidCount', 'lastBidUserId', 'lastBidUserName',
             'lastBidAmount', 'lastBidAt', 'updatedAt', 'bidderIds',
             'likeCount', 'reportCount', 'lastReportedAt'
           ])
      );

      // 입찰 기록: append-only. userId가 본인일 수도, 자동입찰 방어로 상대방일 수도
      // 있어 userId==uid를 강제하지 않아요(대신 금액 양수·수정/삭제 금지로 방어).
      match /bids/{bidId} {
        allow read: if true;
        allow create: if isSignedIn()
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0;
        allow update, delete: if false;
      }

      // 자동입찰 설정: 문서 id가 입찰자 uid(또는 방어 대상 상대 uid)예요.
      // 로그인 사용자면 생성/갱신 허용(상태 exceeded/cancelled 전환 포함), 삭제 금지.
      match /autoBids/{bidderUid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if false;
      }
    }

    // ========================================================================
    //  users — 프로필/설정/배송지. 자기 문서는 자유, 교차쓰기는 특정 필드만.
    // ========================================================================
    match /users/{uid} {
      // 읽기: 로그인 사용자(프로필·검색 목록에 필요). ※ 주소 노출 주의(상단 참고).
      allow read: if isSignedIn();

      // 입찰권 관련 필드(bidTickets/어뷰징 카운터)는 서버(Functions)만 써요.
      // 클라이언트가 자기 문서라도 이 필드를 심어 입찰권을 발급/조작하는 걸 막아요.
      function noTicketFields() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['bidTickets', 'auctionChurnCount', 'lastAuctionChurnAt']);
      }

      // 생성: 본인만. 생성 시 티켓 필드를 심는 것도 금지(가입 지급은 서버 트리거가 함).
      allow create: if isSignedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['bidTickets', 'auctionChurnCount', 'lastAuctionChurnAt']);

      // 수정: 본인(단 티켓 필드는 못 건드림) / 마스터 / 팔로우·리뷰집계 교차쓰기.
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && noTicketFields())
        || isMaster()  // 회원 정지(isSuspended) 등
        // 팔로우/언팔로우 카운터(상대 문서의 followerCount 등)
        || touchesOnly(['uid', 'followerCount', 'followingCount', 'updatedAt'])
        // 리뷰 평점 집계 재계산(상대 문서의 rating/reviewCount)
        || touchesOnly(['rating', 'reviewCount', 'updatedAt'])
      );

      // 삭제: 본인 또는 마스터(계정 탈퇴 등).
      allow delete: if isSignedIn() && (request.auth.uid == uid || isMaster());

      // 팔로워: users/{uid}/followers/{followerUid} — 그 팔로워 본인이 쓰기.
      match /followers/{followerUid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == followerUid;
      }
      // 팔로잉: 문서 소유자 본인만.
      match /following/{targetUid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
      // 찜: 본인만.
      match /favorites/{productId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
      // 알림: 본인 읽기만. 쓰기는 서버(Functions)만 → 클라이언트 금지.
      match /notifications/{notiId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }
      // 입찰권 원장: 본인 읽기만. 지급/소모/회수 기록은 서버(Functions)만 → 클라 금지.
      match /ticketLedger/{entryId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }
      // 향후 권장: 배송지를 여기로 분리해 counterpart에게만 읽기 허용.
      match /private/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ========================================================================
    //  chatRooms — 참여자만. 문서 id = {productId}_{정렬된 두 uid}.
    // ========================================================================
    match /chatRooms/{roomId} {
      function isParticipant() {
        return isSignedIn()
          && (resource == null
              ? request.auth.uid in request.resource.data.participants
              : request.auth.uid in resource.data.participants);
      }
      allow read: if isParticipant();
      // 생성/갱신: 참여자여야 하고, participants에 본인이 포함돼야 해요.
      allow create, update: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        function roomParticipants() {
          return get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
        }
        allow read: if isSignedIn() && request.auth.uid in roomParticipants();
        // 새 메시지: 보낸 사람이 본인.
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid;
        // 읽음표시(readBy) 갱신: 참여자가 readBy만 바꿀 때 허용.
        allow update: if isSignedIn()
          && request.auth.uid in roomParticipants()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        allow delete: if false;
      }
    }

    // ========================================================================
    //  reviews — 거래 완료 후 상대에게 남기는 후기.
    // ========================================================================
    match /reviews/{reviewId} {
      allow read: if true;
      // 작성: 본인이 authorUid. (거래당사자·완료여부 등 세부 검증은 서버/앱에서.)
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;
      // 갱신: 신고 카운트 증가(reportCount)만 타인 허용, 그 외(숨김/삭제)는 마스터.
      allow update: if isSignedIn() && (
        isMaster()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
      );
      allow delete: if isMaster();
    }

    // ========================================================================
    //  신고/리포트 — 작성은 본인, 상태변경은 마스터.
    // ========================================================================
    match /reports/{reportId} {
      allow read: if isMaster();
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow update: if isMaster();
      allow delete: if false;
    }
    match /reviewReports/{docId} {
      allow read: if isMaster();
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow update: if isMaster();
      allow delete: if false;
    }
    match /chatReports/{docId} {
      allow read: if isMaster();
      allow create: if isSignedIn();
      allow update: if isMaster();
      allow delete: if false;
    }

    // ========================================================================
    //  닉네임 예약 / 탈퇴 기록.
    // ========================================================================
    match /nicknames/{nickname} {
      allow read: if true; // 중복 확인용
      // 예약: 새로 잡거나(내 uid), 내가 가진 닉네임을 바꿀 때만.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }
    match /withdrawnAccounts/{emailKey} {
      allow read: if isMaster();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ========================================================================
    //  검색어 인기 카운터 — 로그아웃 상태에서도 검색이 되도록 공개 쓰기.
    //  (민감정보 없음. 남용이 걱정되면 isSignedIn()으로 조여도 됩니다.)
    // ========================================================================
    match /searchKeywords/{keyword} {
      allow read: if true;
      allow write: if true;
    }

    // ========================================================================
    //  공지 / 배너 / 설정 — 읽기 공개, 쓰기는 마스터(또는 콘솔)만.
    // ========================================================================
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isMaster();
    }
    match /homeBanners/{bannerId} {
      allow read: if true;
      allow write: if false; // 콘솔/관리자 도구로만
    }
    match /config/{docId} {
      allow read: if true;   // betaMode/eventFee 등 앱이 읽어야 함
      allow write: if false; // 인증 우회·수수료 스위치 → 콘솔에서만 변경
    }

    // ========================================================================
    //  관리자 로그 — 마스터만.
    // ========================================================================
    match /adminLogs/{logId} {
      allow read: if isMaster();
      allow create: if isMaster();
      allow update, delete: if false;
    }

    // ========================================================================
    //  서버(Cloud Functions) 전용 — 클라이언트 접근 전면 차단.
    //  Functions는 Admin SDK라 규칙을 우회하므로 정상 동작해요.
    // ========================================================================
    match /payments/{orderId} {
      allow read, write: if false;
    }
    match /rateLimits/{docId} {
      allow read, write: if false;
    }
    match /recommendCache/{docId} {
      allow read, write: if false;
    }
    match /adInquiries/{docId} {
      // 이 앱 클라이언트는 쓰지 않아요(웹 폼 등 외부 유입 가정). 콘솔/서버로만.
      allow read, write: if false;
    }

    // ---- 그 외 정의되지 않은 경로는 기본 차단 ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
